# Copy to .env to override locally (compose reads it automatically).
# Database used by the backend container.
DATABASE_URL=postgresql+psycopg://carecircle:carecircle@db:5432/carecircle
# Seed the Mum/Ravi/Priya/Ananya demo family on startup.
SEED_DEMO=true
# Host port for Postgres (5432 may be taken on your machine).
DB_HOST_PORT=5432
# Optional: Groq key for the "Ask about today" assistant.
# Without it, a grounded template assistant is used (still streamed).
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
